# ---------------------------------------------------------------------------
# chatbridge configuration
#
# Copy to .env and fill in. .env is git-ignored.
#
# The Delta Chat account itself is NOT configured here - it is stored in
# ./data/dc and created once with:
#   docker compose run --rm chatbridge init <address> <password>
# or, for a free account on a chatmail server, no mailbox needed:
#   docker compose run --rm chatbridge init DCACCOUNT:nine.testrun.org
# ---------------------------------------------------------------------------

# Who is allowed to use the bot: comma separated Delta Chat addresses.
# Leave this EMPTY for the first run - the bot will refuse everyone but will
# reply with the sender's own address, which you then paste in here.
ALLOWED_SENDERS=

# --- OpenCode --------------------------------------------------------------
# Model to use, as provider/model. Leave unset to use OpenCode's own default.
#OPENCODE_MODEL=opencode/nemotron-3.5-super-vl-free
# Agent definition to run. Defaults to the bundled read-mostly `homeops` agent.
#OPENCODE_AGENT=homeops

# --- behaviour -------------------------------------------------------------
# Seconds a run may take before the bot posts "still working on it".
BRIDGE_ACK_AFTER=12
# Append the shell commands the agent ran to each answer (1 = on, 0 = off).
BRIDGE_SHOW_TOOLS=1
# Abandon a run after this many seconds.
BRIDGE_TIMEOUT=900
# debug | info | warning | error
BRIDGE_LOG=info
